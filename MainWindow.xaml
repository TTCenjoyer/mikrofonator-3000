 </StackPanel><StackPanel Margin="0,0,20,12">
 <Grid><TextBlock Text="Tone High (%)" Style="{StaticResource Label}" />
 <TextBlock x:Name="ReverbHighValue" Style="{StaticResource EffectValue}" /></Grid>
 <Slider x:Name="ReverbHighSlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="100" Value="100"
 ValueChanged="Effect_Changed" AutomationProperties.Name="Tone High" />
 </StackPanel><StackPanel Margin="0,0,20,12">
 <Grid><TextBlock Text="Wet Gain (dB)" Style="{StaticResource Label}" />
 <TextBlock x:Name="ReverbWetValue" Style="{StaticResource EffectValue}" /></Grid>
 <Slider x:Name="ReverbWetSlider" Style="{StaticResource LevelSlider}" Minimum="-30" Maximum="10" Value="-1"
 ValueChanged="Effect_Changed" AutomationProperties.Name="Wet Gain" />
 </StackPanel><StackPanel Margin="0,0,20,12">
 <Grid><TextBlock Text="Dry Gain (dB)" Style="{StaticResource Label}" />
 <TextBlock x:Name="ReverbDryValue" Style="{StaticResource EffectValue}" /></Grid>
 <Slider x:Name="ReverbDrySlider" Style="{StaticResource LevelSlider}" Minimum="-30" Maximum="10" Value="-1"
 ValueChanged="Effect_Changed" AutomationProperties.Name="Dry Gain" />
 </StackPanel><StackPanel Margin="0,0,20,12">
 <Grid><TextBlock Text="Stereo Width (%)" Style="{StaticResource Label}" />
 <TextBlock x:Name="ReverbWidthValue" Style="{StaticResource EffectValue}" /></Grid>
 <Slider x:Name="ReverbWidthSlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="100" Value="70"
 ValueChanged="Effect_Changed" AutomationProperties.Name="Stereo Width" />
 </StackPanel></StackPanel>
 <StackPanel Orientation="Horizontal">
 <CheckBox x:Name="ReverbWetOnly" Style="{StaticResource MonitorSwitch}" Checked="Effect_Changed" Unchecked="Effect_Changed"
 AutomationProperties.Name="Wet Only" />
 <TextBlock Text="Wet Only — sam pogłos" VerticalAlignment="Center" Margin="9,0,0,0" />
 </StackPanel>
 </StackPanel></Expander>
</StackPanel>
                        <Border Grid.Column="3" Width="1" Background="{StaticResource LineBrush}" />
                        <StackPanel Grid.Column="4">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Echo" Style="{StaticResource EffectTitle}" />
                                <CheckBox x:Name="EchoToggle" Style="{StaticResource MonitorSwitch}" HorizontalAlignment="Right"
                                          Checked="Effect_Changed" Unchecked="Effect_Changed"
                                          AutomationProperties.Name="Echo po głosie" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Odstęp echa" Style="{StaticResource Label}" />
                                <TextBlock x:Name="EchoTimeValue" Style="{StaticResource EffectValue}" />
                            </Grid>
                            <Slider x:Name="EchoTimeSlider" Style="{StaticResource LevelSlider}" Minimum="100" Maximum="1200" Value="350"
                                    TickFrequency="25" SmallChange="25" LargeChange="100"
                                    ValueChanged="Effect_Changed" AutomationProperties.Name="Odstęp echa po głosie" />
                            <Grid Margin="0,3,0,0">
                                <TextBlock Text="Głośność" Style="{StaticResource Label}" />
                                <TextBlock x:Name="EchoMixValue" Style="{StaticResource EffectValue}" />
                            </Grid>
                            <Slider x:Name="EchoMixSlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="100" Value="30"
                                    ValueChanged="Effect_Changed" AutomationProperties.Name="Głośność echa po głosie" />
