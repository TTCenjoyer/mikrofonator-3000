<Window x:Class="FiltrMikrofonu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:FiltrMikrofonu"
        Title="Filtr Mikrofonu" Icon="Microphone.ico" Width="1032" Height="894" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource InkBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Language="pl-PL"
        SnapsToDevicePixels="True" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="25,22,25,16" MaxWidth="1250">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="51" Height="51" CornerRadius="13" BorderThickness="1" BorderBrush="#574479" Margin="0,0,13,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#473368" Offset="0" />
                                <GradientStop Color="#29203E" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Path Data="M2,13 L2,17 M8,9 L8,21 M14,4 L14,26 M20,8 L20,22 M26,12 L26,18"
                              Stroke="{StaticResource AccentHoverBrush}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Filtr Mikrofonu" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="29"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" Padding="11,6" CornerRadius="13" Margin="0,0,13,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock x:Name="StatusText" Text="Gotowy" Foreground="{StaticResource SecondaryBrush}" FontSize="11" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Button x:Name="StartButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Click="Start_Click"
                        VerticalAlignment="Center" MinWidth="159" AutomationProperties.Name="Uruchom mikrofon">
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="StartGlyph" Data="M2,1 L11,6.5 2,12 Z" Fill="{StaticResource AccentDarkBrush}"
                              Margin="0,0,9,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="StartText" Text="Uruchom mikrofon" Foreground="{StaticResource AccentDarkBrush}" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="306" />
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <Grid Margin="0,0,0,15">
                            <TextBlock Text="Urządzenia" Style="{StaticResource PanelHeading}" VerticalAlignment="Center" />
                            <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="Refresh_Click"
                                    ToolTip="Odśwież listę urządzeń" AutomationProperties.Name="Odśwież listę urządzeń">
                                <Path Data="M13,6 A5.3,5.3 0 1 0 13,11 M13,2 V6 H9" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.45"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Button>
                        </Grid>
                        <TextBlock Text="Mikrofon" Style="{StaticResource Label}" Margin="0,0,0,6" />
                        <ComboBox x:Name="MicrophoneBox" Style="{StaticResource DevicePicker}" SelectionChanged="Device_Changed"
                                  AutomationProperties.Name="Mikrofon" />
                        <TextBlock Text="Wyjście" Style="{StaticResource Label}" Margin="0,14,0,6" />
                        <ComboBox x:Name="OutputBox" Style="{StaticResource DevicePicker}" SelectionChanged="Device_Changed"
                                  AutomationProperties.Name="Wyjście przetworzonego dźwięku" />
                        <Border Background="#272039" BorderBrush="#3D3056" BorderThickness="1" CornerRadius="8" Padding="10,9" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Data="M8,1 A7,7 0 1 1 7.99,1 M8,7 V11 M8,4.7 V4.8" Stroke="{StaticResource AccentBrush}"
                                      StrokeThickness="1.35" StrokeStartLineCap="Round" Height="16" Width="16" Stretch="Uniform"
                                      VerticalAlignment="Top" Margin="0,1,8,0" />
                                <TextBlock x:Name="OutputHint" Grid.Column="1" Foreground="#DBCEF7" FontSize="11" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,17,0,13" />
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Odsłuch + wysyłanie" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            <CheckBox x:Name="MonitorToggle" HorizontalAlignment="Right" Style="{StaticResource MonitorSwitch}"
                                      Checked="Monitor_Changed" Unchecked="Monitor_Changed" AutomationProperties.Name="Odsłuch w słuchawkach" />
                        </Grid>
                        <ComboBox x:Name="MonitorBox" Style="{StaticResource DevicePicker}" SelectionChanged="MonitorDevice_Changed"
                                  AutomationProperties.Name="Urządzenie odsłuchu" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Filtry głosu" Style="{StaticResource PanelHeading}" Margin="0,1,0,17" />
                        <ListBox x:Name="FilterBox" BorderThickness="0" Background="Transparent" Margin="0,0,-8,0"
                                 ItemContainerStyle="{StaticResource FilterCard}" SelectedValuePath="Id" SelectionChanged="Effect_Changed"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Filtry głosu" KeyboardNavigation.DirectionalNavigation="Contained">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="3" Rows="2" /></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Title}" /></DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,8,0,12" />

                        <Grid>
                            <TextBlock Text="Intensywność filtru" Style="{StaticResource Label}" />
                            <TextBlock x:Name="MixValue" Text="100%" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Grid>
                        <Slider x:Name="MixSlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="100" Value="100"
                                ValueChanged="Effect_Changed" AutomationProperties.Name="Intensywność filtru" />

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="17" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Wzmocnienie wejścia" Style="{StaticResource Label}" />
                                    <TextBlock x:Name="InputValue" Text="0 dB" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{StaticResource AccentBrush}" />
                                </Grid>
                                <Slider x:Name="InputSlider" Style="{StaticResource LevelSlider}" Minimum="-18" Maximum="24" Value="0"
                                        ValueChanged="Effect_Changed" AutomationProperties.Name="Wzmocnienie wejścia" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Grid>
                                    <TextBlock Text="Wzmocnienie wyjścia" Style="{StaticResource Label}" />
                                    <TextBlock x:Name="OutputValue" Text="0 dB" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{StaticResource AccentBrush}" />
                                </Grid>
                                <Slider x:Name="OutputSlider" Style="{StaticResource LevelSlider}" Minimum="-24" Maximum="12" Value="0"
                                        ValueChanged="Effect_Changed" AutomationProperties.Name="Wzmocnienie wyjścia" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>


            <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="20,15" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Sygnał wejściowy" Style="{StaticResource Label}" />
                            <TextBlock x:Name="InputDb" Text="−∞ dBFS" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        </Grid>
                        <ui:LevelMeter x:Name="InputMeter" Height="10" Accent="{StaticResource AccentBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Sygnał wyjściowy" Style="{StaticResource Label}" />
                            <TextBlock x:Name="OutputDb" Text="−∞ dBFS" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        </Grid>
                        <ui:LevelMeter x:Name="OutputMeter" Height="10" Accent="{StaticResource MintBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource Panel}" Padding="20,16" Margin="0,14,0,0">
                <Border.Resources>
                    <Style x:Key="EffectValue" TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Right" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                    </Style>
                    <Style x:Key="EffectTitle" TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FontSize" Value="14" />
                    </Style>
                </Border.Resources>
                <StackPanel>
                    <Expander Header="Bramka i redukcja szumów" IsExpanded="True" Foreground="{StaticResource InkBrush}" Margin="0,0,0,18">
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel Grid.Column="0"><Grid Margin="0,0,0,10"><TextBlock Text="Bramka szumów" Style="{StaticResource EffectTitle}"/><CheckBox x:Name="GateToggle" Style="{StaticResource MonitorSwitch}" HorizontalAlignment="Right" Checked="Effect_Changed" Unchecked="Effect_Changed" AutomationProperties.Name="Bramka szumów"/></Grid><Grid><TextBlock Text="Próg otwarcia" Style="{StaticResource Label}"/><TextBlock x:Name="GateThresholdValue" Style="{StaticResource EffectValue}"/></Grid><Slider x:Name="GateThresholdSlider" Minimum="-75" Maximum="-10" Value="-42" Style="{StaticResource LevelSlider}" ValueChanged="Effect_Changed" AutomationProperties.Name="Próg otwarcia"/><Grid><TextBlock Text="Podtrzymanie" Style="{StaticResource Label}"/><TextBlock x:Name="GateHoldValue" Style="{StaticResource EffectValue}"/></Grid><Slider x:Name="GateHoldSlider" Minimum="0" Maximum="500" Value="120" Style="{StaticResource LevelSlider}" ValueChanged="Effect_Changed" AutomationProperties.Name="Podtrzymanie"/><Grid><TextBlock Text="Wygaszanie" Style="{StaticResource Label}"/><TextBlock x:Name="GateReleaseValue" Style="{StaticResource EffectValue}"/></Grid><Slider x:Name="GateReleaseSlider" Minimum="30" Maximum="1000" Value="150" Style="{StaticResource LevelSlider}" ValueChanged="Effect_Changed" AutomationProperties.Name="Wygaszanie"/></StackPanel><StackPanel Grid.Column="2"><Grid Margin="0,0,0,10"><TextBlock Text="Redukcja szumów" Style="{StaticResource EffectTitle}"/><CheckBox x:Name="DenoiseToggle" Style="{StaticResource MonitorSwitch}" HorizontalAlignment="Right" Checked="Effect_Changed" Unchecked="Effect_Changed" AutomationProperties.Name="Redukcja szumów"/></Grid><Grid><TextBlock Text="Poziom szumu" Style="{StaticResource Label}"/><TextBlock x:Name="NoiseFloorValue" Style="{StaticResource EffectValue}"/></Grid><Slider x:Name="NoiseFloorSlider" Minimum="-75" Maximum="-20" Value="-48" Style="{StaticResource LevelSlider}" ValueChanged="Effect_Changed" AutomationProperties.Name="Poziom szumu"/><Grid><TextBlock Text="Siła redukcji" Style="{StaticResource Label}"/><TextBlock x:Name="NoiseReductionValue" Style="{StaticResource EffectValue}"/></Grid><Slider x:Name="NoiseReductionSlider" Minimum="0" Maximum="100" Value="65" Style="{StaticResource LevelSlider}" ValueChanged="Effect_Changed" AutomationProperties.Name="Siła redukcji"/></StackPanel></Grid></Expander>
                    <TextBlock Text="Preverb, reverb i echo" Style="{StaticResource PanelHeading}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Preverb" Style="{StaticResource EffectTitle}" />
                                <CheckBox x:Name="BeforeToggle" Style="{StaticResource MonitorSwitch}" HorizontalAlignment="Right"
                                          Checked="Before_Changed" Unchecked="Before_Changed"
                                          AutomationProperties.Name="Preverb" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Czas narastania" Style="{StaticResource Label}" />
                                <TextBlock x:Name="BeforeTimeValue" Style="{StaticResource EffectValue}" />
                            </Grid>
                            <Slider x:Name="BeforeTimeSlider" Style="{StaticResource LevelSlider}" Minimum="400" Maximum="2400" Value="1300"
                                    TickFrequency="100" SmallChange="100" LargeChange="300"
                                    ValueChanged="Effect_Changed" AutomationProperties.Name="Czas preverb" />
                            <Grid Margin="0,3,0,0">
                                <TextBlock Text="Głośność" Style="{StaticResource Label}" />
                                <TextBlock x:Name="BeforeMixValue" Style="{StaticResource EffectValue}" />
                            </Grid>
                            <Slider x:Name="BeforeMixSlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="100" Value="100"
                                    ValueChanged="Effect_Changed" AutomationProperties.Name="Głośność preverb" />
                        <Expander Header="Ustawienia Preverb" IsExpanded="True" Foreground="{StaticResource InkBrush}" Margin="0,14,0,0">
 <StackPanel Margin="0,14,0,0">
 <StackPanel><StackPanel Margin="0,0,20,12">
 <Grid><TextBlock Text="Room Size (%)" Style="{StaticResource Label}" />
 <TextBlock x:Name="PreverbSizeValue" Style="{StaticResource EffectValue}" /></Grid>
 <Slider x:Name="PreverbSizeSlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="100" Value="50"
 ValueChanged="Effect_Changed" AutomationProperties.Name="Preverb Room Size" />
 </StackPanel><StackPanel Margin="0,0,20,12">
 <Grid><TextBlock Text="Pre-delay (ms)" Style="{StaticResource Label}" />
 <TextBlock x:Name="PreverbPreDelayValue" Style="{StaticResource EffectValue}" /></Grid>
 <Slider x:Name="PreverbPreDelaySlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="200" Value="22"
 ValueChanged="Effect_Changed" AutomationProperties.Name="Preverb Pre-delay" />
 </StackPanel><StackPanel Margin="0,0,20,12">
 <Grid><TextBlock Text="Reverberance (%)" Style="{StaticResource Label}" />
 <TextBlock x:Name="PreverbDecayValue" Style="{StaticResource EffectValue}" /></Grid>
 <Slider x:Name="PreverbDecaySlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="100" Value="50"
 ValueChanged="Effect_Changed" AutomationProperties.Name="Preverb Reverberance" />
 </StackPanel><StackPanel Margin="0,0,20,12">
 <Grid><TextBlock Text="Damping (%)" Style="{StaticResource Label}" />
 <TextBlock x:Name="PreverbDampingValue" Style="{StaticResource EffectValue}" /></Grid>
 <Slider x:Name="PreverbDampingSlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="100" Value="99"
 ValueChanged="Effect_Changed" AutomationProperties.Name="Preverb Damping" />
 </StackPanel><StackPanel Margin="0,0,20,12">
 <Grid><TextBlock Text="Tone Low (%)" Style="{StaticResource Label}" />
 <TextBlock x:Name="PreverbLowValue" Style="{StaticResource EffectValue}" /></Grid>
 <Slider x:Name="PreverbLowSlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="100" Value="50"
 ValueChanged="Effect_Changed" AutomationProperties.Name="Preverb Tone Low" />
 </StackPanel><StackPanel Margin="0,0,20,12">
 <Grid><TextBlock Text="Tone High (%)" Style="{StaticResource Label}" />
 <TextBlock x:Name="PreverbHighValue" Style="{StaticResource EffectValue}" /></Grid>
 <Slider x:Name="PreverbHighSlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="100" Value="100"
 ValueChanged="Effect_Changed" AutomationProperties.Name="Preverb Tone High" />
 </StackPanel><StackPanel Margin="0,0,20,12">
 <Grid><TextBlock Text="Wet Gain (dB)" Style="{StaticResource Label}" />
 <TextBlock x:Name="PreverbWetValue" Style="{StaticResource EffectValue}" /></Grid>
 <Slider x:Name="PreverbWetSlider" Style="{StaticResource LevelSlider}" Minimum="-30" Maximum="10" Value="-1"
 ValueChanged="Effect_Changed" AutomationProperties.Name="Preverb Wet Gain" />
 </StackPanel><StackPanel Margin="0,0,20,12">
 <Grid><TextBlock Text="Dry Gain (dB)" Style="{StaticResource Label}" />
 <TextBlock x:Name="PreverbDryValue" Style="{StaticResource EffectValue}" /></Grid>
 <Slider x:Name="PreverbDrySlider" Style="{StaticResource LevelSlider}" Minimum="-30" Maximum="10" Value="-1"
 ValueChanged="Effect_Changed" AutomationProperties.Name="Preverb Dry Gain" />
 </StackPanel><StackPanel Margin="0,0,20,12">
 <Grid><TextBlock Text="Stereo Width (%)" Style="{StaticResource Label}" />
 <TextBlock x:Name="PreverbWidthValue" Style="{StaticResource EffectValue}" /></Grid>
 <Slider x:Name="PreverbWidthSlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="100" Value="70"
 ValueChanged="Effect_Changed" AutomationProperties.Name="Preverb Stereo Width" />
 </StackPanel></StackPanel>
 <StackPanel Orientation="Horizontal">
 <CheckBox x:Name="PreverbWetOnly" Style="{StaticResource MonitorSwitch}" Checked="Effect_Changed" Unchecked="Effect_Changed"
 AutomationProperties.Name="Preverb Wet Only" />
 <TextBlock Text="Wet Only — sam pogłos" VerticalAlignment="Center" Margin="9,0,0,0" />
 </StackPanel>
 </StackPanel></Expander>
</StackPanel>
                        <Border Grid.Column="1" Width="1" Background="{StaticResource LineBrush}" />
                        <StackPanel Grid.Column="2">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Reverb" Style="{StaticResource EffectTitle}" />
                                <CheckBox x:Name="RoomToggle" Style="{StaticResource MonitorSwitch}" HorizontalAlignment="Right"
                                          Checked="Effect_Changed" Unchecked="Effect_Changed"
                                          AutomationProperties.Name="Reverb" />
                            </Grid>
                            <TextBlock Text="Wielkość, barwa i stereo" Foreground="{StaticResource SecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock Text="Parametry pogłosu" Foreground="{StaticResource SecondaryBrush}" FontSize="12" Margin="0,5,0,0" />
                        <Expander Header="Ustawienia Reverb" IsExpanded="True" Foreground="{StaticResource InkBrush}" Margin="0,14,0,0">
 <StackPanel Margin="0,14,0,0">
 <StackPanel><StackPanel Margin="0,0,20,12">
 <Grid><TextBlock Text="Room Size (%)" Style="{StaticResource Label}" />
 <TextBlock x:Name="ReverbSizeValue" Style="{StaticResource EffectValue}" /></Grid>
 <Slider x:Name="ReverbSizeSlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="100" Value="50"
 ValueChanged="Effect_Changed" AutomationProperties.Name="Room Size" />
 </StackPanel><StackPanel Margin="0,0,20,12">
 <Grid><TextBlock Text="Pre-delay (ms)" Style="{StaticResource Label}" />
 <TextBlock x:Name="ReverbPreDelayValue" Style="{StaticResource EffectValue}" /></Grid>
 <Slider x:Name="ReverbPreDelaySlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="200" Value="22"
 ValueChanged="Effect_Changed" AutomationProperties.Name="Pre-delay" />
 </StackPanel><StackPanel Margin="0,0,20,12">
 <Grid><TextBlock Text="Reverberance (%)" Style="{StaticResource Label}" />
 <TextBlock x:Name="ReverbDecayValue" Style="{StaticResource EffectValue}" /></Grid>
 <Slider x:Name="ReverbDecaySlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="100" Value="50"
 ValueChanged="Effect_Changed" AutomationProperties.Name="Reverberance" />
 </StackPanel><StackPanel Margin="0,0,20,12">
 <Grid><TextBlock Text="Damping (%)" Style="{StaticResource Label}" />
 <TextBlock x:Name="ReverbDampingValue" Style="{StaticResource EffectValue}" /></Grid>
 <Slider x:Name="ReverbDampingSlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="100" Value="99"
 ValueChanged="Effect_Changed" AutomationProperties.Name="Damping" />
 </StackPanel><StackPanel Margin="0,0,20,12">
 <Grid><TextBlock Text="Tone Low (%)" Style="{StaticResource Label}" />
 <TextBlock x:Name="ReverbLowValue" Style="{StaticResource EffectValue}" /></Grid>
 <Slider x:Name="ReverbLowSlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="100" Value="50"
 ValueChanged="Effect_Changed" AutomationProperties.Name="Tone Low" />
 </StackPanel><StackPanel Margin="0,0,20,12">
 <Grid><TextBlock Text="Tone High (%)" Style="{StaticResource Label}" />
 <TextBlock x:Name="ReverbHighValue" Style="{StaticResource EffectValue}" /></Grid>
 <Slider x:Name="ReverbHighSlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="100" Value="100"
 ValueChanged="Effect_Changed" AutomationProperties.Name="Tone High" />
 </StackPanel><StackPanel Margin="0,0,20,12">
 <Grid><TextBlock Text="Wet Gain (dB)" Style="{StaticResource Label}" />
 <TextBlock x:Name="ReverbWetValue" Style="{StaticResource EffectValue}" /></Grid>
 <Slider x:Name="ReverbWetSlider" Style="{StaticResource LevelSlider}" Minimum="-30" Maximum="10" Value="-1"
 ValueChanged="Effect_Changed" AutomationProperties.Name="Wet Gain" />
 </StackPanel><StackPanel Margin="0,0,20,12">
 <Grid><TextBlock Text="Dry Gain (dB)" Style="{StaticResource Label}" />
 <TextBlock x:Name="ReverbDryValue" Style="{StaticResource EffectValue}" /></Grid>
 <Slider x:Name="ReverbDrySlider" Style="{StaticResource LevelSlider}" Minimum="-30" Maximum="10" Value="-1"
 ValueChanged="Effect_Changed" AutomationProperties.Name="Dry Gain" />
 </StackPanel><StackPanel Margin="0,0,20,12">
 <Grid><TextBlock Text="Stereo Width (%)" Style="{StaticResource Label}" />
 <TextBlock x:Name="ReverbWidthValue" Style="{StaticResource EffectValue}" /></Grid>
 <Slider x:Name="ReverbWidthSlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="100" Value="70"
 ValueChanged="Effect_Changed" AutomationProperties.Name="Stereo Width" />
 </StackPanel></StackPanel>
 <StackPanel Orientation="Horizontal">
 <CheckBox x:Name="ReverbWetOnly" Style="{StaticResource MonitorSwitch}" Checked="Effect_Changed" Unchecked="Effect_Changed"
 AutomationProperties.Name="Wet Only" />
 <TextBlock Text="Wet Only — sam pogłos" VerticalAlignment="Center" Margin="9,0,0,0" />
 </StackPanel>
 </StackPanel></Expander>
</StackPanel>
                        <Border Grid.Column="3" Width="1" Background="{StaticResource LineBrush}" />
                        <StackPanel Grid.Column="4">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Echo" Style="{StaticResource EffectTitle}" />
                                <CheckBox x:Name="EchoToggle" Style="{StaticResource MonitorSwitch}" HorizontalAlignment="Right"
                                          Checked="Effect_Changed" Unchecked="Effect_Changed"
                                          AutomationProperties.Name="Echo po głosie" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Odstęp echa" Style="{StaticResource Label}" />
                                <TextBlock x:Name="EchoTimeValue" Style="{StaticResource EffectValue}" />
                            </Grid>
                            <Slider x:Name="EchoTimeSlider" Style="{StaticResource LevelSlider}" Minimum="100" Maximum="1200" Value="350"
                                    TickFrequency="25" SmallChange="25" LargeChange="100"
                                    ValueChanged="Effect_Changed" AutomationProperties.Name="Odstęp echa po głosie" />
                            <Grid Margin="0,3,0,0">
                                <TextBlock Text="Głośność" Style="{StaticResource Label}" />
                                <TextBlock x:Name="EchoMixValue" Style="{StaticResource EffectValue}" />
                            </Grid>
                            <Slider x:Name="EchoMixSlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="100" Value="30"
                                    ValueChanged="Effect_Changed" AutomationProperties.Name="Głośność echa po głosie" />
                        </StackPanel>
                    </Grid>
                    
                    
                </StackPanel>
            </Border>

            <Grid Grid.Row="4" Margin="3,11,3,0" MinHeight="17">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusDetail" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="AudioInfo" Grid.Column="1" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" />
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
