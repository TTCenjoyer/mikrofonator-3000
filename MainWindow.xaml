<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ui="clr-namespace:FiltrMikrofonu" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="FiltrMikrofonu.MainWindow" Title="Filtr Mikrofonu" Icon="Microphone.ico" Width="1420" Height="894" MinWidth="1180" MinHeight="560" WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource InkBrush}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Language="pl-PL" SnapsToDevicePixels="True" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="22,20,22,14" MaxWidth="1720">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="51" Height="51" CornerRadius="13" BorderThickness="1" BorderBrush="#294763" Margin="0,0,13,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1D344A" Offset="0" />
                            <GradientStop Color="#101D2A" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Path Data="M2,13 L2,17 M8,9 L8,21 M14,4 L14,26 M20,8 L20,22 M26,12 L26,18" Stroke="{StaticResource AccentHoverBrush}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Filtr Mikrofonu" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="29" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="11,6" CornerRadius="13" Margin="0,0,13,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock x:Name="StatusText" Text="Gotowy" Foreground="{StaticResource SecondaryBrush}" FontSize="11" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Button x:Name="StartButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Click="Start_Click" VerticalAlignment="Center" MinWidth="159" AutomationProperties.Name="Uruchom mikrofon">
                <StackPanel Orientation="Horizontal">
                    <Path x:Name="StartGlyph" Data="M2,1 L11,6.5 2,12 Z" Fill="{StaticResource AccentDarkBrush}" Margin="0,0,9,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="StartText" Text="Uruchom mikrofon" Foreground="{StaticResource AccentDarkBrush}" />
                </StackPanel>
            </Button>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="240" />
            </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Top">
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <Grid Margin="0,0,0,15">
                            <TextBlock Text="Urządzenia" Style="{StaticResource PanelHeading}" VerticalAlignment="Center" />
                            <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="Refresh_Click" ToolTip="Odśwież listę urządzeń" AutomationProperties.Name="Odśwież listę urządzeń">
                                <Path Data="M13,6 A5.3,5.3 0 1 0 13,11 M13,2 V6 H9" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.45" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Button>
                        </Grid>
                        <TextBlock Text="Mikrofon" Style="{StaticResource Label}" Margin="0,0,0,6" />
                        <ComboBox x:Name="MicrophoneBox" Style="{StaticResource DevicePicker}" SelectionChanged="Device_Changed" AutomationProperties.Name="Mikrofon" />
                        <TextBlock Text="Wyjście" Style="{StaticResource Label}" Margin="0,14,0,6" />
                        <ComboBox x:Name="OutputBox" Style="{StaticResource DevicePicker}" SelectionChanged="Device_Changed" AutomationProperties.Name="Wyjście przetworzonego dźwięku" />
                        <Border Background="#142131" BorderBrush="#2A4058" BorderThickness="1" CornerRadius="8" Padding="10,9" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Data="M8,1 A7,7 0 1 1 7.99,1 M8,7 V11 M8,4.7 V4.8" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.35" StrokeStartLineCap="Round" Height="16" Width="16" Stretch="Uniform" VerticalAlignment="Top" Margin="0,1,8,0" />
                                <TextBlock x:Name="OutputHint" Grid.Column="1" Foreground="#B9CDDF" FontSize="11" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,17,0,13" />
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Odsłuch + wysyłanie" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            <CheckBox x:Name="MonitorToggle" HorizontalAlignment="Right" Style="{StaticResource MonitorSwitch}" Checked="Monitor_Changed" Unchecked="Monitor_Changed" AutomationProperties.Name="Odsłuch w słuchawkach" />
                        </Grid>
                        <ComboBox x:Name="MonitorBox" Style="{StaticResource DevicePicker}" SelectionChanged="MonitorDevice_Changed" AutomationProperties.Name="Urządzenie odsłuchu" />
                    </StackPanel>
                </Border>
            </ScrollViewer>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,7,0">
                <StackPanel>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="Presety" Style="{StaticResource PanelHeading}" Margin="0,1,0,17" />
                            <ListBox x:Name="FilterBox" BorderThickness="0" Background="Transparent" Margin="0,0,-8,0" ItemContainerStyle="{StaticResource FilterCard}" SelectedValuePath="Id" SelectionChanged="Effect_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Presety" KeyboardNavigation.DirectionalNavigation="Contained">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" Rows="2" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,8,0,12" />
                            <Grid>
                                <TextBlock Text="Wybierz preset lub dopasuj filtry po prawej" Style="{StaticResource Label}" />
                                <TextBlock x:Name="MixValue" Text="100%" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AccentBrush}" Visibility="Collapsed" />
                            </Grid>
                            <Slider x:Name="MixSlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="100" Value="100" ValueChanged="Effect_Changed" AutomationProperties.Name="Intensywność presetu" Visibility="Collapsed" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="17" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Wzmocnienie wejścia" Style="{StaticResource Label}" />
                                        <TextBlock x:Name="InputValue" Text="0 dB" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                    </Grid>
                                    <Slider x:Name="InputSlider" Style="{StaticResource LevelSlider}" Minimum="-18" Maximum="24" Value="0" ValueChanged="Effect_Changed" AutomationProperties.Name="Wzmocnienie wejścia" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Grid>
                                        <TextBlock Text="Wzmocnienie wyjścia" Style="{StaticResource Label}" />
                                        <TextBlock x:Name="OutputValue" Text="0 dB" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                    </Grid>
                                    <Slider x:Name="OutputSlider" Style="{StaticResource LevelSlider}" Minimum="-24" Maximum="12" Value="0" ValueChanged="Effect_Changed" AutomationProperties.Name="Wzmocnienie wyjścia" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="PresetState" Text="Czysty — wszystkie filtry wyłączone" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" FontSize="11" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Padding="20,15" Margin="0,14,0,0" Height="74" VerticalAlignment="Top">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Sygnał wejściowy" Style="{StaticResource Label}" />
                                    <TextBlock x:Name="InputDb" Text="−∞ dBFS" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                </Grid>
                                <ui:LevelMeter x:Name="InputMeter" Height="10" Accent="{StaticResource AccentBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Sygnał wyjściowy" Style="{StaticResource Label}" />
                                    <TextBlock x:Name="OutputDb" Text="−∞ dBFS" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                </Grid>
                                <ui:LevelMeter x:Name="OutputMeter" Height="10" Accent="{StaticResource MintBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Panel}" Padding="20,16" Margin="0,14,0,0">
                        <Border.Resources>
                            <Style x:Key="EffectValue" TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Style>
                            <Style x:Key="EffectTitle" TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="14" />
                            </Style>
                        </Border.Resources>
                        <StackPanel>
                            <Expander Header="Bramka i redukcja szumów" IsExpanded="True" Foreground="{StaticResource InkBrush}" Margin="0,0,0,18">
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="Bramka szumów" Style="{StaticResource EffectTitle}" />
                                            <CheckBox x:Name="GateToggle" Style="{StaticResource MonitorSwitch}" HorizontalAlignment="Right" Checked="Effect_Changed" Unchecked="Effect_Changed" AutomationProperties.Name="Bramka szumów" />
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="Próg otwarcia" Style="{StaticResource Label}" />
                                            <TextBlock x:Name="GateThresholdValue" Style="{StaticResource EffectValue}" />
                                        </Grid>
                                        <Slider x:Name="GateThresholdSlider" Minimum="-75" Maximum="-10" Value="-42" Style="{StaticResource LevelSlider}" ValueChanged="Effect_Changed" AutomationProperties.Name="Próg otwarcia" />
                                        <Grid>
                                            <TextBlock Text="Podtrzymanie" Style="{StaticResource Label}" />
                                            <TextBlock x:Name="GateHoldValue" Style="{StaticResource EffectValue}" />
                                        </Grid>
                                        <Slider x:Name="GateHoldSlider" Minimum="0" Maximum="500" Value="120" Style="{StaticResource LevelSlider}" ValueChanged="Effect_Changed" AutomationProperties.Name="Podtrzymanie" />
                                        <Grid>
                                            <TextBlock Text="Wygaszanie" Style="{StaticResource Label}" />
                                            <TextBlock x:Name="GateReleaseValue" Style="{StaticResource EffectValue}" />
                                        </Grid>
                                        <Slider x:Name="GateReleaseSlider" Minimum="30" Maximum="1000" Value="150" Style="{StaticResource LevelSlider}" ValueChanged="Effect_Changed" AutomationProperties.Name="Wygaszanie" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="Redukcja szumów" Style="{StaticResource EffectTitle}" />
                                            <CheckBox x:Name="DenoiseToggle" Style="{StaticResource MonitorSwitch}" HorizontalAlignment="Right" Checked="Effect_Changed" Unchecked="Effect_Changed" AutomationProperties.Name="Redukcja szumów" />
                                        </Grid>
                                        <ComboBox x:Name="NoiseModeBox" Style="{StaticResource DevicePicker}" SelectedIndex="0" SelectionChanged="Effect_Changed" Margin="0,0,0,10" AutomationProperties.Name="Tryb redukcji szumów">
                                            <ComboBoxItem Content="AI — RNNoise" />
                                            <ComboBoxItem Content="Klasyczny — widmowy" />
                                        </ComboBox>
                                        <StackPanel x:Name="NeuralControls">
                                            <Grid>
                                                <TextBlock Text="Siła redukcji AI" Style="{StaticResource Label}" />
                                                <TextBlock x:Name="NeuralStrengthValue" Style="{StaticResource EffectValue}" />
                                            </Grid>
                                            <Slider x:Name="NeuralStrengthSlider" Minimum="0" Maximum="100" Value="100" Style="{StaticResource LevelSlider}" ValueChanged="Effect_Changed" AutomationProperties.Name="Siła redukcji AI" />
                                            <CheckBox x:Name="AutomaticVoiceGateToggle" Content="Automatyczna czułość (VAD)" Foreground="{StaticResource SecondaryBrush}" Checked="Effect_Changed" Unchecked="Effect_Changed" Margin="0,4,0,10" />
                                        </StackPanel>
                                        <StackPanel x:Name="LegacyNoiseControls">
                                            <Grid>
                                                <TextBlock Text="Poziom szumu" Style="{StaticResource Label}" />
                                                <TextBlock x:Name="NoiseFloorValue" Style="{StaticResource EffectValue}" />
                                            </Grid>
                                            <Slider x:Name="NoiseFloorSlider" Minimum="-75" Maximum="-20" Value="-48" Style="{StaticResource LevelSlider}" ValueChanged="Effect_Changed" AutomationProperties.Name="Poziom szumu" />
                                            <Grid>
                                                <TextBlock Text="Siła redukcji" Style="{StaticResource Label}" />
                                                <TextBlock x:Name="NoiseReductionValue" Style="{StaticResource EffectValue}" />
                                            </Grid>
                                            <Slider x:Name="NoiseReductionSlider" Minimum="0" Maximum="100" Value="65" Style="{StaticResource LevelSlider}" ValueChanged="Effect_Changed" AutomationProperties.Name="Siła redukcji" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Expander>
                            <Expander Header="Eliminacja echa rozmowy" IsExpanded="True" Foreground="{StaticResource InkBrush}" Margin="0,0,0,16">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="Dźwięk ze słuchawek jest odniesieniem do usuwania głosu wracającego do mikrofonu. Wybierz to samo wyjście co w Discordzie." TextWrapping="Wrap" Style="{StaticResource Label}" Margin="0,0,0,10" />
                                    <Grid>
                                        <TextBlock Text="Usuwanie echa (AEC)" Style="{StaticResource EffectTitle}" />
                                        <CheckBox x:Name="AecToggle" Style="{StaticResource MonitorSwitch}" HorizontalAlignment="Right" Checked="Aec_Changed" Unchecked="Aec_Changed" AutomationProperties.Name="Usuwanie echa rozmowy" />
                                    </Grid>
                                    <ComboBox x:Name="EchoReferenceBox" Style="{StaticResource DevicePicker}" SelectionChanged="Aec_Changed" Margin="0,10,0,10" AutomationProperties.Name="Słuchawki — odniesienie do eliminacji echa" />
                                    <Grid>
                                        <TextBlock Text="Opóźnienie odniesienia" Style="{StaticResource Label}" />
                                        <TextBlock x:Name="AecDelayValue" Style="{StaticResource EffectValue}" />
                                    </Grid>
                                    <Slider x:Name="AecDelaySlider" Minimum="0" Maximum="250" Value="0" Style="{StaticResource LevelSlider}" ValueChanged="Effect_Changed" AutomationProperties.Name="Opóźnienie odniesienia echa" />
                                    <Button Content="Ustaw jak w moim Discordzie" Click="DiscordNoisePreset_Click" Background="{StaticResource FieldBrush}" Foreground="{StaticResource InkBrush}" BorderBrush="{StaticResource LineBrush}" Padding="10,7" HorizontalAlignment="Left" Margin="0,7,0,0" />
                                    <TextBlock Text="Profil Własny: AI, usuwanie echa, automatyczna czułość i regulacja głośności. RNNoise i AEC są lokalne; to nie jest silnik Krisp." TextWrapping="Wrap" Style="{StaticResource Label}" FontSize="10" Margin="0,7,0,0" />
                                </StackPanel>
                            </Expander>
                            <TextBlock Text="Preverb, reverb i echo" Style="{StaticResource PanelHeading}" Margin="0,0,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Preverb" Style="{StaticResource EffectTitle}" />
                                        <CheckBox x:Name="BeforeToggle" Style="{StaticResource MonitorSwitch}" HorizontalAlignment="Right" Checked="Before_Changed" Unchecked="Before_Changed" AutomationProperties.Name="Preverb" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Czas narastania" Style="{StaticResource Label}" />
                                        <TextBlock x:Name="BeforeTimeValue" Style="{StaticResource EffectValue}" />
                                    </Grid>
                                    <Slider x:Name="BeforeTimeSlider" Style="{StaticResource LevelSlider}" Minimum="400" Maximum="2400" Value="1300" TickFrequency="100" SmallChange="100" LargeChange="300" ValueChanged="Effect_Changed" AutomationProperties.Name="Czas preverb" />
                                    <Grid Margin="0,3,0,0">
                                        <TextBlock Text="Głośność" Style="{StaticResource Label}" />
                                        <TextBlock x:Name="BeforeMixValue" Style="{StaticResource EffectValue}" />
                                    </Grid>
                                    <Slider x:Name="BeforeMixSlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="100" Value="100" ValueChanged="Effect_Changed" AutomationProperties.Name="Głośność preverb" />
                                    <Expander Header="Ustawienia Preverb" IsExpanded="True" Foreground="{StaticResource InkBrush}" Margin="0,14,0,0">
                                        <StackPanel Margin="0,14,0,0">
                                            <StackPanel>
                                                <StackPanel Margin="0,0,20,12">
                                                    <Grid>
                                                        <TextBlock Text="Room Size (%)" Style="{StaticResource Label}" />
                                                        <TextBlock x:Name="PreverbSizeValue" Style="{StaticResource EffectValue}" />
                                                    </Grid>
                                                    <Slider x:Name="PreverbSizeSlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="100" Value="50" ValueChanged="Effect_Changed" AutomationProperties.Name="Preverb Room Size" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,20,12">
                                                    <Grid>
                                                        <TextBlock Text="Pre-delay (ms)" Style="{StaticResource Label}" />
                                                        <TextBlock x:Name="PreverbPreDelayValue" Style="{StaticResource EffectValue}" />
                                                    </Grid>
                                                    <Slider x:Name="PreverbPreDelaySlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="200" Value="22" ValueChanged="Effect_Changed" AutomationProperties.Name="Preverb Pre-delay" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,20,12">
                                                    <Grid>
                                                        <TextBlock Text="Reverberance (%)" Style="{StaticResource Label}" />
                                                        <TextBlock x:Name="PreverbDecayValue" Style="{StaticResource EffectValue}" />
                                                    </Grid>
                                                    <Slider x:Name="PreverbDecaySlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="100" Value="50" ValueChanged="Effect_Changed" AutomationProperties.Name="Preverb Reverberance" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,20,12">
                                                    <Grid>
                                                        <TextBlock Text="Damping (%)" Style="{StaticResource Label}" />
                                                        <TextBlock x:Name="PreverbDampingValue" Style="{StaticResource EffectValue}" />
                                                    </Grid>
                                                    <Slider x:Name="PreverbDampingSlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="100" Value="99" ValueChanged="Effect_Changed" AutomationProperties.Name="Preverb Damping" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,20,12">
                                                    <Grid>
                                                        <TextBlock Text="Tone Low (%)" Style="{StaticResource Label}" />
                                                        <TextBlock x:Name="PreverbLowValue" Style="{StaticResource EffectValue}" />
                                                    </Grid>
                                                    <Slider x:Name="PreverbLowSlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="100" Value="50" ValueChanged="Effect_Changed" AutomationProperties.Name="Preverb Tone Low" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,20,12">
                                                    <Grid>
                                                        <TextBlock Text="Tone High (%)" Style="{StaticResource Label}" />
                                                        <TextBlock x:Name="PreverbHighValue" Style="{StaticResource EffectValue}" />
                                                    </Grid>
                                                    <Slider x:Name="PreverbHighSlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="100" Value="100" ValueChanged="Effect_Changed" AutomationProperties.Name="Preverb Tone High" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,20,12">
                                                    <Grid>
                                                        <TextBlock Text="Wet Gain (dB)" Style="{StaticResource Label}" />
                                                        <TextBlock x:Name="PreverbWetValue" Style="{StaticResource EffectValue}" />
                                                    </Grid>
                                                    <Slider x:Name="PreverbWetSlider" Style="{StaticResource LevelSlider}" Minimum="-30" Maximum="10" Value="-1" ValueChanged="Effect_Changed" AutomationProperties.Name="Preverb Wet Gain" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,20,12">
                                                    <Grid>
                                                        <TextBlock Text="Dry Gain (dB)" Style="{StaticResource Label}" />
                                                        <TextBlock x:Name="PreverbDryValue" Style="{StaticResource EffectValue}" />
                                                    </Grid>
                                                    <Slider x:Name="PreverbDrySlider" Style="{StaticResource LevelSlider}" Minimum="-30" Maximum="10" Value="-1" ValueChanged="Effect_Changed" AutomationProperties.Name="Preverb Dry Gain" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,20,12">
                                                    <Grid>
                                                        <TextBlock Text="Stereo Width (%)" Style="{StaticResource Label}" />
                                                        <TextBlock x:Name="PreverbWidthValue" Style="{StaticResource EffectValue}" />
                                                    </Grid>
                                                    <Slider x:Name="PreverbWidthSlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="100" Value="70" ValueChanged="Effect_Changed" AutomationProperties.Name="Preverb Stereo Width" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox x:Name="PreverbWetOnly" Style="{StaticResource MonitorSwitch}" Checked="Effect_Changed" Unchecked="Effect_Changed" AutomationProperties.Name="Preverb Wet Only" />
                                                <TextBlock Text="Wet Only — sam pogłos" VerticalAlignment="Center" Margin="9,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                                <Border Grid.Column="1" Width="1" Background="{StaticResource LineBrush}" />
                                <StackPanel Grid.Column="2">
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Reverb" Style="{StaticResource EffectTitle}" />
                                        <CheckBox x:Name="RoomToggle" Style="{StaticResource MonitorSwitch}" HorizontalAlignment="Right" Checked="Effect_Changed" Unchecked="Effect_Changed" AutomationProperties.Name="Reverb" />
                                    </Grid>
                                    <TextBlock Text="Wielkość, barwa i stereo" Foreground="{StaticResource SecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    <TextBlock Text="Parametry pogłosu" Foreground="{StaticResource SecondaryBrush}" FontSize="12" Margin="0,5,0,0" />
                                    <Expander Header="Ustawienia Reverb" IsExpanded="True" Foreground="{StaticResource InkBrush}" Margin="0,14,0,0">
                                        <StackPanel Margin="0,14,0,0">
                                            <StackPanel>
                                                <StackPanel Margin="0,0,20,12">
                                                    <Grid>
                                                        <TextBlock Text="Room Size (%)" Style="{StaticResource Label}" />
                                                        <TextBlock x:Name="ReverbSizeValue" Style="{StaticResource EffectValue}" />
                                                    </Grid>
                                                    <Slider x:Name="ReverbSizeSlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="100" Value="50" ValueChanged="Effect_Changed" AutomationProperties.Name="Room Size" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,20,12">
                                                    <Grid>
                                                        <TextBlock Text="Pre-delay (ms)" Style="{StaticResource Label}" />
                                                        <TextBlock x:Name="ReverbPreDelayValue" Style="{StaticResource EffectValue}" />
                                                    </Grid>
                                                    <Slider x:Name="ReverbPreDelaySlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="200" Value="22" ValueChanged="Effect_Changed" AutomationProperties.Name="Pre-delay" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,20,12">
                                                    <Grid>
                                                        <TextBlock Text="Reverberance (%)" Style="{StaticResource Label}" />
                                                        <TextBlock x:Name="ReverbDecayValue" Style="{StaticResource EffectValue}" />
                                                    </Grid>
                                                    <Slider x:Name="ReverbDecaySlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="100" Value="50" ValueChanged="Effect_Changed" AutomationProperties.Name="Reverberance" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,20,12">
                                                    <Grid>
                                                        <TextBlock Text="Damping (%)" Style="{StaticResource Label}" />
                                                        <TextBlock x:Name="ReverbDampingValue" Style="{StaticResource EffectValue}" />
                                                    </Grid>
                                                    <Slider x:Name="ReverbDampingSlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="100" Value="99" ValueChanged="Effect_Changed" AutomationProperties.Name="Damping" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,20,12">
                                                    <Grid>
                                                        <TextBlock Text="Tone Low (%)" Style="{StaticResource Label}" />
                                                        <TextBlock x:Name="ReverbLowValue" Style="{StaticResource EffectValue}" />
                                                    </Grid>
                                                    <Slider x:Name="ReverbLowSlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="100" Value="50" ValueChanged="Effect_Changed" AutomationProperties.Name="Tone Low" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,20,12">
                                                    <Grid>
                                                        <TextBlock Text="Tone High (%)" Style="{StaticResource Label}" />
                                                        <TextBlock x:Name="ReverbHighValue" Style="{StaticResource EffectValue}" />
                                                    </Grid>
                                                    <Slider x:Name="ReverbHighSlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="100" Value="100" ValueChanged="Effect_Changed" AutomationProperties.Name="Tone High" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,20,12">
                                                    <Grid>
                                                        <TextBlock Text="Wet Gain (dB)" Style="{StaticResource Label}" />
                                                        <TextBlock x:Name="ReverbWetValue" Style="{StaticResource EffectValue}" />
                                                    </Grid>
                                                    <Slider x:Name="ReverbWetSlider" Style="{StaticResource LevelSlider}" Minimum="-30" Maximum="10" Value="-1" ValueChanged="Effect_Changed" AutomationProperties.Name="Wet Gain" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,20,12">
                                                    <Grid>
                                                        <TextBlock Text="Dry Gain (dB)" Style="{StaticResource Label}" />
                                                        <TextBlock x:Name="ReverbDryValue" Style="{StaticResource EffectValue}" />
                                                    </Grid>
                                                    <Slider x:Name="ReverbDrySlider" Style="{StaticResource LevelSlider}" Minimum="-30" Maximum="10" Value="-1" ValueChanged="Effect_Changed" AutomationProperties.Name="Dry Gain" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,20,12">
                                                    <Grid>
                                                        <TextBlock Text="Stereo Width (%)" Style="{StaticResource Label}" />
                                                        <TextBlock x:Name="ReverbWidthValue" Style="{StaticResource EffectValue}" />
                                                    </Grid>
                                                    <Slider x:Name="ReverbWidthSlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="100" Value="70" ValueChanged="Effect_Changed" AutomationProperties.Name="Stereo Width" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox x:Name="ReverbWetOnly" Style="{StaticResource MonitorSwitch}" Checked="Effect_Changed" Unchecked="Effect_Changed" AutomationProperties.Name="Wet Only" />
                                                <TextBlock Text="Wet Only — sam pogłos" VerticalAlignment="Center" Margin="9,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                                <Border Grid.Column="3" Width="1" Background="{StaticResource LineBrush}" />
                                <StackPanel Grid.Column="4">
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Echo" Style="{StaticResource EffectTitle}" />
                                        <CheckBox x:Name="EchoToggle" Style="{StaticResource MonitorSwitch}" HorizontalAlignment="Right" Checked="Effect_Changed" Unchecked="Effect_Changed" AutomationProperties.Name="Echo po głosie" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Odstęp echa" Style="{StaticResource Label}" />
                                        <TextBlock x:Name="EchoTimeValue" Style="{StaticResource EffectValue}" />
                                    </Grid>
                                    <Slider x:Name="EchoTimeSlider" Style="{StaticResource LevelSlider}" Minimum="100" Maximum="1200" Value="350" TickFrequency="25" SmallChange="25" LargeChange="100" ValueChanged="Effect_Changed" AutomationProperties.Name="Odstęp echa po głosie" />
                                    <Grid Margin="0,3,0,0">
                                        <TextBlock Text="Głośność" Style="{StaticResource Label}" />
                                        <TextBlock x:Name="EchoMixValue" Style="{StaticResource EffectValue}" />
                                    </Grid>
                                    <Slider x:Name="EchoMixSlider" Style="{StaticResource LevelSlider}" Minimum="0" Maximum="100" Value="30" ValueChanged="Effect_Changed" AutomationProperties.Name="Głośność echa po głosie" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Grid Margin="3,11,3,0" MinHeight="17">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusDetail" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="AudioInfo" Grid.Column="1" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
            <Border Style="{StaticResource Panel}" VerticalAlignment="Top" Grid.Column="4">
                <StackPanel>
                    <TextBlock Text="Filtry" Style="{StaticResource PanelHeading}" Margin="0,0,0,6" />
                    <TextBlock Text="Włącz i otwórz ustawienia" Style="{StaticResource Label}" FontSize="11" Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Equalizer  ›" Tag="Eq" Click="OpenFilter_Click" HorizontalContentAlignment="Left" Padding="10,13" Margin="0,0,9,0" Background="{StaticResource FieldBrush}" Foreground="{StaticResource InkBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Cursor="Hand" AutomationProperties.Name="Ustawienia — Equalizer" />
                        <CheckBox x:Name="EqToggle" HorizontalAlignment="Right" Style="{StaticResource MonitorSwitch}" Checked="Effect_Changed" Unchecked="Effect_Changed" AutomationProperties.Name="Korektor — EQ" Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Górnoprzepustowy  ›" Tag="HighPass" Click="OpenFilter_Click" HorizontalContentAlignment="Left" Padding="10,13" Margin="0,0,9,0" Background="{StaticResource FieldBrush}" Foreground="{StaticResource InkBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Cursor="Hand" AutomationProperties.Name="Ustawienia — Górnoprzepustowy" />
                        <CheckBox x:Name="HighPassToggle" HorizontalAlignment="Right" Style="{StaticResource MonitorSwitch}" Checked="Effect_Changed" Unchecked="Effect_Changed" AutomationProperties.Name="Filtr górnoprzepustowy" Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Przester  ›" Tag="Distortion" Click="OpenFilter_Click" HorizontalContentAlignment="Left" Padding="10,13" Margin="0,0,9,0" Background="{StaticResource FieldBrush}" Foreground="{StaticResource InkBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Cursor="Hand" AutomationProperties.Name="Ustawienia — Przester" />
                        <CheckBox x:Name="DistortionToggle" HorizontalAlignment="Right" Style="{StaticResource MonitorSwitch}" Checked="Effect_Changed" Unchecked="Effect_Changed" AutomationProperties.Name="Przester — distortion" Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Normalizator  ›" Tag="Normalizer" Click="OpenFilter_Click" HorizontalContentAlignment="Left" Padding="10,13" Margin="0,0,9,0" Background="{StaticResource FieldBrush}" Foreground="{StaticResource InkBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Cursor="Hand" AutomationProperties.Name="Ustawienia — Normalizator" />
                        <CheckBox x:Name="NormalizerToggle" HorizontalAlignment="Right" Style="{StaticResource MonitorSwitch}" Checked="Effect_Changed" Unchecked="Effect_Changed" AutomationProperties.Name="Normalizator" Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Dolnoprzepustowy  ›" Tag="LowPass" Click="OpenFilter_Click" HorizontalContentAlignment="Left" Padding="10,13" Margin="0,0,9,0" Background="{StaticResource FieldBrush}" Foreground="{StaticResource InkBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Cursor="Hand" AutomationProperties.Name="Ustawienia — Dolnoprzepustowy" />
                        <CheckBox x:Name="LowPassToggle" Style="{StaticResource MonitorSwitch}" Checked="Effect_Changed" Unchecked="Effect_Changed" AutomationProperties.Name="Dolnoprzepustowy" Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Kompresor  ›" Tag="Compression" Click="OpenFilter_Click" HorizontalContentAlignment="Left" Padding="10,13" Margin="0,0,9,0" Background="{StaticResource FieldBrush}" Foreground="{StaticResource InkBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Cursor="Hand" AutomationProperties.Name="Ustawienia — Kompresor" />
                        <CheckBox x:Name="CompressionToggle" Style="{StaticResource MonitorSwitch}" Checked="Effect_Changed" Unchecked="Effect_Changed" AutomationProperties.Name="Kompresor" Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Wysokość tonu  ›" Tag="Pitch" Click="OpenFilter_Click" HorizontalContentAlignment="Left" Padding="10,13" Margin="0,0,9,0" Background="{StaticResource FieldBrush}" Foreground="{StaticResource InkBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Cursor="Hand" AutomationProperties.Name="Ustawienia — Wysokość tonu" />
                        <CheckBox x:Name="PitchToggle" Style="{StaticResource MonitorSwitch}" Checked="Effect_Changed" Unchecked="Effect_Changed" AutomationProperties.Name="Wysokość tonu" Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        <Grid Visibility="Collapsed" x:Name="FilterPanelStorage">
            <StackPanel x:Name="EqPanel">
                <TextBlock Text="Kliknij, aby dodać punkt. Przeciągaj w obu osiach. Prawy klik / Delete usuwa punkt." Style="{StaticResource Label}" TextWrapping="Wrap" FontSize="11" />
                <ui:EqualizerEditor x:Name="EqEditor" Height="330" Margin="0,8,0,8" />
                <WrapPanel Margin="0,0,0,12">
                    <CheckBox x:Name="EqLinearScale" Content="Liniowa skala częstotliwości" Checked="EqView_Changed" Unchecked="EqView_Changed" Foreground="{StaticResource SecondaryBrush}" Margin="0,0,20,0" />
                    <CheckBox x:Name="EqGridToggle" Content="Siatka" IsChecked="True" Checked="EqView_Changed" Unchecked="EqView_Changed" Foreground="{StaticResource SecondaryBrush}" />
                </WrapPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Częstotliwość (Hz)" Style="{StaticResource Label}" />
                        <TextBox x:Name="EqHzBox" Margin="0,5,0,0" Padding="8" Background="{StaticResource FieldBrush}" Foreground="{StaticResource InkBrush}" BorderBrush="{StaticResource LineBrush}" KeyDown="EqNumber_KeyDown" AutomationProperties.Name="Częstotliwość punktu EQ" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Wzmocnienie (dB)" Style="{StaticResource Label}" />
                        <TextBox x:Name="EqDbBox" Margin="0,5,0,0" Padding="8" Background="{StaticResource FieldBrush}" Foreground="{StaticResource InkBrush}" BorderBrush="{StaticResource LineBrush}" KeyDown="EqNumber_KeyDown" AutomationProperties.Name="Wzmocnienie punktu EQ" />
                    </StackPanel>
                    <Button Grid.Column="4" Content="Zmień punkt" Tag="Edit" Click="EqAction_Click" VerticalAlignment="Bottom" Padding="12,8" Background="{StaticResource FieldBrush}" Foreground="{StaticResource InkBrush}" BorderBrush="{StaticResource LineBrush}" />
                </Grid>
                <TextBlock x:Name="EqEditStatus" Text="20–20 000 Hz · od −30 do +30 dB" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,10" />
                <WrapPanel>
                    <WrapPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.4" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonSurface" Property="Background" Value="{StaticResource HoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </WrapPanel.Resources>
                    <Button Content="Dodaj punkt" Tag="Add" Click="EqAction_Click" Padding="10,7" Margin="0,0,7,7" />
                    <Button x:Name="EqDeleteButton" Content="Usuń punkt" Tag="Delete" Click="EqAction_Click" Padding="10,7" Margin="0,0,7,7" />
                    <Button Content="Poprzedni" Tag="Previous" Click="EqAction_Click" Padding="10,7" Margin="0,0,7,7" />
                    <Button Content="Następny" Tag="Next" Click="EqAction_Click" Padding="10,7" Margin="0,0,7,7" />
                    <Button Content="Wyzeruj EQ" Click="ResetEq_Click" Padding="10,7" Margin="0,0,7,7" />
                    <Button Content="Odwróć krzywą" Tag="Invert" Click="EqAction_Click" Padding="10,7" Margin="0,0,7,7" />
                    <Button x:Name="EqUndoButton" Content="Cofnij" Tag="Undo" Click="EqAction_Click" Padding="10,7" Margin="0,0,7,7" />
                    <Button x:Name="EqRedoButton" Content="Ponów" Tag="Redo" Click="EqAction_Click" Padding="10,7" Margin="0,0,7,7" />
                </WrapPanel>
                <TextBlock Text="Strzałki zmieniają Hz i dB; Shift zwiększa precyzję. Page Up / Down wybierają punkt. Ctrl+Z / Ctrl+Y cofa i ponawia." Style="{StaticResource Label}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel x:Name="HighPassPanel">
                <Grid>
                    <TextBlock Text="Częstotliwość" Style="{StaticResource Label}" />
                    <TextBlock x:Name="HighPassValue" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontSize="11" />
                </Grid>
                <Slider x:Name="HighPassSlider" Minimum="20" Maximum="3000" Value="80" Style="{StaticResource LevelSlider}" ValueChanged="Effect_Changed" AutomationProperties.Name="Częstotliwość" />
                <ComboBox x:Name="SlopeBox" Style="{StaticResource DevicePicker}" SelectedIndex="0" SelectionChanged="Effect_Changed" AutomationProperties.Name="Nachylenie filtra">
                    <ComboBoxItem Content="12 dB / oktawę" />
                    <ComboBoxItem Content="24 dB / oktawę" />
                    <ComboBoxItem Content="48 dB / oktawę" />
                    <ComboBoxItem Content="6 dB / oktawę" />
                </ComboBox>
            </StackPanel>
            <StackPanel x:Name="DistortionPanel">
                <ComboBox x:Name="DistortionTypeBox" Style="{StaticResource DevicePicker}" SelectedIndex="0" SelectionChanged="Effect_Changed" Margin="0,0,0,15" AutomationProperties.Name="Typ przesteru">
                    <ComboBoxItem Content="Standardowy — tanh / obcinanie" />
                    <ComboBoxItem Content="Medium Overdrive" />
                </ComboBox>
                <StackPanel x:Name="StandardDistortionPanel">
                    <Grid>
                        <TextBlock Text="Przesterowanie" Style="{StaticResource Label}" />
                        <TextBlock x:Name="DriveValue" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontSize="11" />
                    </Grid>
                    <Slider x:Name="DriveSlider" Minimum="0" Maximum="30" Value="12" Style="{StaticResource LevelSlider}" ValueChanged="Effect_Changed" AutomationProperties.Name="Przesterowanie" />
                    <Grid>
                        <TextBlock Text="Poziom przesteru" Style="{StaticResource Label}" />
                        <TextBlock x:Name="DistortionOutputValue" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontSize="11" />
                    </Grid>
                    <Slider x:Name="DistortionOutputSlider" Minimum="-24" Maximum="0" Value="-6" Style="{StaticResource LevelSlider}" ValueChanged="Effect_Changed" AutomationProperties.Name="Poziom przesteru" />
                    <CheckBox x:Name="HardClippingToggle" Content="Twarde obcinanie" Foreground="{StaticResource SecondaryBrush}" Checked="Effect_Changed" Unchecked="Effect_Changed" />
                </StackPanel>
                <StackPanel x:Name="MediumOverdrivePanel">
                    <Grid>
                        <TextBlock Text="Distortion amount (0–100)" Style="{StaticResource Label}" />
                        <TextBlock x:Name="OverdriveAmountValue" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" />
                    </Grid>
                    <Slider x:Name="OverdriveAmountSlider" Minimum="0" Maximum="100" Value="49" Style="{StaticResource LevelSlider}" ValueChanged="Effect_Changed" AutomationProperties.Name="Distortion amount" />
                    <Grid>
                        <TextBlock Text="Output level (0–100)" Style="{StaticResource Label}" />
                        <TextBlock x:Name="OverdriveOutputValue" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" />
                    </Grid>
                    <Slider x:Name="OverdriveOutputSlider" Minimum="0" Maximum="100" Value="50" Style="{StaticResource LevelSlider}" ValueChanged="Effect_Changed" AutomationProperties.Name="Output level" />
                </StackPanel>
                <Grid>
                    <TextBlock Text="Domieszka" Style="{StaticResource Label}" />
                    <TextBlock x:Name="DistortionMixValue" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontSize="11" />
                </Grid>
                <Slider x:Name="DistortionMixSlider" Minimum="0" Maximum="100" Value="50" Style="{StaticResource LevelSlider}" ValueChanged="Effect_Changed" AutomationProperties.Name="Domieszka" />
            </StackPanel>
            <StackPanel x:Name="NormalizerPanel">
                <Grid>
                    <TextBlock Text="Poziom docelowy" Style="{StaticResource Label}" />
                    <TextBlock x:Name="NormalizeValue" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontSize="11" />
                </Grid>
                <Slider x:Name="NormalizeSlider" Minimum="-24" Maximum="-1" Value="-3" Style="{StaticResource LevelSlider}" ValueChanged="Effect_Changed" AutomationProperties.Name="Poziom docelowy" />
                <Grid>
                    <TextBlock Text="Maks. podbicie" Style="{StaticResource Label}" />
                    <TextBlock x:Name="MaxGainValue" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontSize="11" />
                </Grid>
                <Slider x:Name="MaxGainSlider" Minimum="0" Maximum="18" Value="12" Style="{StaticResource LevelSlider}" ValueChanged="Effect_Changed" AutomationProperties.Name="Maks. podbicie" />
                <TextBlock Text="Automatyczna regulacja poziomu na żywo" Style="{StaticResource Label}" FontSize="10" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel x:Name="LowPassPanel">
                <Grid>
                    <TextBlock Text="Częstotliwość odcięcia (Hz)" Style="{StaticResource Label}" />
                    <TextBlock x:Name="LowPassValue" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontSize="11" />
                </Grid>
                <Slider x:Name="LowPassSlider" Minimum="20" Maximum="20000" Value="3500" Style="{StaticResource LevelSlider}" ValueChanged="Effect_Changed" AutomationProperties.Name="Częstotliwość odcięcia (Hz)" />
                <ComboBox x:Name="LowPassSlopeBox" Style="{StaticResource DevicePicker}" SelectedIndex="0" SelectionChanged="Effect_Changed" AutomationProperties.Name="Nachylenie filtra dolnoprzepustowego">
                    <ComboBoxItem Content="12 dB / oktawę" />
                    <ComboBoxItem Content="24 dB / oktawę" />
                    <ComboBoxItem Content="48 dB / oktawę" />
                </ComboBox>
            </StackPanel>
            <StackPanel x:Name="CompressionPanel">
                <Grid>
                    <TextBlock Text="Próg (dB)" Style="{StaticResource Label}" />
                    <TextBlock x:Name="CompressorThresholdValue" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontSize="11" />
                </Grid>
                <Slider x:Name="CompressorThresholdSlider" Minimum="-60" Maximum="0" Value="-18" Style="{StaticResource LevelSlider}" ValueChanged="Effect_Changed" AutomationProperties.Name="Próg (dB)" />
                <Grid>
                    <TextBlock Text="Proporcja (ratio)" Style="{StaticResource Label}" />
                    <TextBlock x:Name="CompressorRatioValue" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontSize="11" />
                </Grid>
                <Slider x:Name="CompressorRatioSlider" Minimum="1" Maximum="20" Value="3" Style="{StaticResource LevelSlider}" ValueChanged="Effect_Changed" AutomationProperties.Name="Proporcja (ratio)" />
                <Grid>
                    <TextBlock Text="Atak (ms)" Style="{StaticResource Label}" />
                    <TextBlock x:Name="CompressorAttackValue" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontSize="11" />
                </Grid>
                <Slider x:Name="CompressorAttackSlider" Minimum="1" Maximum="200" Value="10" Style="{StaticResource LevelSlider}" ValueChanged="Effect_Changed" AutomationProperties.Name="Atak (ms)" />
                <Grid>
                    <TextBlock Text="Powrót (ms)" Style="{StaticResource Label}" />
                    <TextBlock x:Name="CompressorReleaseValue" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontSize="11" />
                </Grid>
                <Slider x:Name="CompressorReleaseSlider" Minimum="20" Maximum="2000" Value="120" Style="{StaticResource LevelSlider}" ValueChanged="Effect_Changed" AutomationProperties.Name="Powrót (ms)" />
                <Grid>
                    <TextBlock Text="Wzmocnienie (dB)" Style="{StaticResource Label}" />
                    <TextBlock x:Name="CompressorMakeupValue" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontSize="11" />
                </Grid>
                <Slider x:Name="CompressorMakeupSlider" Minimum="-12" Maximum="24" Value="3" Style="{StaticResource LevelSlider}" ValueChanged="Effect_Changed" AutomationProperties.Name="Wzmocnienie (dB)" />
                <Grid>
                    <TextBlock Text="Domieszka (%)" Style="{StaticResource Label}" />
                    <TextBlock x:Name="CompressionValue" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontSize="11" />
                </Grid>
                <Slider x:Name="CompressionSlider" Minimum="0" Maximum="100" Value="100" Style="{StaticResource LevelSlider}" ValueChanged="Effect_Changed" AutomationProperties.Name="Domieszka (%)" />
            </StackPanel>
            <StackPanel x:Name="PitchPanel">
                <Grid>
                    <TextBlock Text="Zmiana wysokości (półtony)" Style="{StaticResource Label}" />
                    <TextBlock x:Name="PitchValue" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontSize="11" />
                </Grid>
                <Slider x:Name="PitchSlider" Minimum="-12" Maximum="12" Value="-5" Style="{StaticResource LevelSlider}" ValueChanged="Effect_Changed" AutomationProperties.Name="Zmiana wysokości (półtony)" />
                <Grid>
                    <TextBlock Text="Domieszka (%)" Style="{StaticResource Label}" />
                    <TextBlock x:Name="PitchMixValue" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontSize="11" />
                </Grid>
                <Slider x:Name="PitchMixSlider" Minimum="0" Maximum="100" Value="100" Style="{StaticResource LevelSlider}" ValueChanged="Effect_Changed" AutomationProperties.Name="Domieszka (%)" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>